\uc0\u51089 \u49457  \u53412 \u50892 \u46300  \u47785 \u47197 :\
1. \uc0\u51068 \u48376  \u52712 \u50629 \u48708 \u51088  \u49888 \u52397  \u51208 \u52264  \'97 \u54620 \u44397 \u51064 \u51060  \u54924 \u49324  \u45236 \u51221  \u54980  \u51456 \u48708 \u54624  \u44163 \u46308 \
2. \uc0\u51068 \u48376  \u44148 \u44053 \u48372 \u54744  \u44032 \u51077  \u48169 \u48277  \'97 \u44397 \u48124 \u44148 \u44053 \u48372 \u54744 \u44284  \u54924 \u49324  \u49324 \u54924 \u48372 \u54744  \u52264 \u51060 \
