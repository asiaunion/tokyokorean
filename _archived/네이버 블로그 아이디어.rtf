- \uc0\u54616 \u47336  1~2\u44060 , 2\u51452  \u45236  10\u44060  \u50756 \u47308  \u47785 \u54364 \
- \uc0\u44033  \u54252 \u49828 \u53944 \u45716  \u46021 \u47549 \u46108  \u51452 \u51228 , \u45236 \u50857  \u51473 \u48373  \u50630 \u51060  \u51089 \u49457 \
