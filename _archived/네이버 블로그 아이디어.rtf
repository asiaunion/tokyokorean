5. \uc0\u54620 \u44397  \u50868 \u51204 \u47732 \u54728 \u47484  \u51068 \u48376  \u47732 \u54728 \u47196  \u48148 \u44984 \u45716  \u48169 \u48277  \'97 \u50808 \u47732 \u51208 \u52264  \u51456 \u48708  \u49436 \u47448 \
