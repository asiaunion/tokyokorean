---
import type { HTMLAttributes } from "astro/types";
import { defaultUiLang, getUi, type UiLang } from "@/i18n/ui";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
  uiLang?: UiLang;
} & HTMLAttributes<"footer">;

const {
  noMarginTop = false,
  uiLang: uiLangProp,
  class: className,
  ...attrs
} = Astro.props;

const lang = (uiLangProp ?? defaultUiLang()) as UiLang;
const l = "";
const L = getUi(lang);

---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="py-6 sm:py-8 border-t border-border flex flex-col gap-4 sm:gap-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-wrap items-center justify-center sm:justify-start text-sm opacity-80 gap-3 sm:gap-4 w-full">
        <a href={`${l}/about/`} class="link-subtle">{L.footerAbout}</a>
        <span>&middot;</span>
        <a href={`${l}/contact/`} class="link-subtle">{L.footerContact}</a>
        <span>&middot;</span>
        <a href={`${l}/privacy-policy/`} class="link-subtle">{L.footerPrivacy}</a>
        <span>&middot;</span>
        <a href={`${l}/terms/`} class="link-subtle">{L.footerTerms}</a>
      </div>
    </div>
    <div class="flex flex-col items-center sm:items-start text-xs sm:text-sm opacity-60 text-center sm:text-left gap-1">
      <div class="flex flex-col sm:flex-row items-center gap-1 sm:gap-2">
        <span>{L.footerCopyright} &#169; {currentYear} TokyoKorean.</span>
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>{L.footerAllRights}</span>
      </div>
      <div class="mt-1">
        <span>{L.footerAdsNotice}</span>
      </div>
    </div>
  </div>
</footer>
